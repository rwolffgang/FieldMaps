{
	"compilerOptions": {
		"target": "ES2021",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2021", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,
		"useDefineForClassFields": false,
		"experimentalDecorators": true,
		"verbatimModuleSyntax": false,
		"types": ["vite/client", "vite-plugin-pwa/client"]
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
