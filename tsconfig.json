{
	"compilerOptions": {
		"target": "ES2021",
		"module": "ESNext",
		"moduleResolution": "bundler",
		// The workspace packages export their TypeScript source under this condition, so
		// the app builds them from source instead of from a `dist/` that may not exist.
		"customConditions": ["source"],
		"lib": ["ES2021", "DOM", "DOM.Iterable"],
		"strict": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,
		"useDefineForClassFields": false,
		"experimentalDecorators": true,
		"verbatimModuleSyntax": false,
		"types": ["vite/client", "vite-plugin-pwa/client"]
	},
	"include": ["src", "packages/*/src", "packages/field-map/test-page"],
	"exclude": ["src/**/*.test.ts", "packages/*/src/**/*.test.ts"]
}
