# Cloudflare custom headers, honoured by Workers static assets.
# The service worker script is how a client finds out a new build exists at all
# (src/update.ts re-fetches it on a timer), so it must never be answered from a
# cache — an edge or browser copy of yesterday's sw.js is an app that cannot
# update. The manifest changes rarely but is just as cheap to revalidate.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Vite emits content-hashed filenames under /assets, so they can be cached
# forever — a new build produces a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
