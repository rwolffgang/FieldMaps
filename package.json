{
	"name": "airsoft-field-map",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"build": "tsc --noEmit && vite build",
		"preview": "npm run build && wrangler dev",
		"serve": "vite preview --host 0.0.0.0 --port 4173",
		"tunnel": "npx --yes localtunnel --port 4173",
		"test": "tsx src/transform.test.ts && tsx src/radiation.test.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky",
		"deploy": "npm run build && wrangler deploy"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,css,html,md}": "prettier --write"
	},
	"dependencies": {
		"leaflet": "^1.9.4",
		"lit": "^3.2.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.44.0",
		"@types/leaflet": "^1.9.12",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"prettier": "^3.6.2",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3",
		"vite": "^8.1.3",
		"vite-plugin-pwa": "^1.3.0",
		"wrangler": "^4.110.0"
	}
}
